---
import Icon from './Icon.astro'
import SectionHead from './SectionHead.astro'
import { apps } from '../data/site'

interface Props {
  heading?: 'h1' | 'h2'
}

const { heading = 'h2' } = Astro.props
const count = apps.length
// Curvas desde cada integración (columna izquierda) hasta el centro del diagrama.
const curves = apps.map((_, i) => {
  const y = ((i + 0.5) / count) * 100
  return `M31 ${y} C42 ${y} 40 50 50 50`
})
---

<section id="apps" class="px-4 py-24 md:px-6 md:py-32">
  <div class="mx-auto max-w-7xl">
    <SectionHead eyebrow="Integraciones" heading={heading}>
      <Fragment slot="title">Se conecta con <span class="text-fg/45">lo que ya usás</span></Fragment>
      POS Cloud no reemplaza tus canales: los une. Los pedidos, el stock y la facturación quedan sincronizados en el mismo sistema.
    </SectionHead>

    <div class="card relative mt-14 overflow-hidden p-5 md:p-8" data-reveal>
      <div class="bg-grid pointer-events-none absolute inset-0 opacity-50" aria-hidden="true"></div>


      <div class="relative grid items-center gap-8 md:h-[460px] md:grid-cols-[31%_1fr_31%] md:gap-0">
        <svg class="pointer-events-none absolute inset-0 hidden h-full w-full md:block" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          {
            curves.map((d) => (
              <>
                <path d={d} fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="1" vector-effect="non-scaling-stroke" />
                <path data-flow d={d} fill="none" stroke="var(--color-sky)" stroke-width="1.5" vector-effect="non-scaling-stroke" stroke-linecap="round" />
              </>
            ))
          }
          <path d="M50 50 L69 50" fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="1" vector-effect="non-scaling-stroke" />
          <path data-flow d="M50 50 L69 50" fill="none" stroke="var(--color-sky)" stroke-width="1.5" vector-effect="non-scaling-stroke" stroke-linecap="round" />
        </svg>
        <ul class="grid gap-2.5 md:h-full md:grid-rows-6 md:gap-0">
          {
            apps.map(([src, name]) => (
              <li class="flex items-center">
                <div class="flex w-full items-center gap-3 rounded-xl bg-white px-3 py-2 text-ink shadow-lg md:mr-0">
                  <img src={src} alt="" width="28" height="28" loading="lazy" decoding="async" class="h-7 w-7 shrink-0 object-contain" />
                  <span class="text-sm font-medium">{name}</span>
                  <span class="ml-auto h-2 w-2 rounded-full bg-ok shadow-[0_0_8px_var(--color-ok)]" />
                </div>
              </li>
            ))
          }
        </ul>

        <div class="flex justify-center" aria-hidden="true">
          <div class="relative grid h-28 w-28 place-items-center">
            <span data-pulse class="absolute inset-0 rounded-full border border-sky/30"></span>
            <span data-pulse class="absolute inset-0 rounded-full border border-sky/30"></span>
            <div class="relative grid h-24 w-24 place-items-center rounded-3xl border border-sky/40 bg-gradient-to-b from-blue to-navy shadow-[0_0_60px_-4px_var(--color-blue)]">
              <Icon name="cloud-check" class="text-4xl text-white" />
            </div>
          </div>
        </div>

        <div class="rounded-2xl bg-white p-4 text-ink shadow-2xl" aria-hidden="true">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm font-semibold">Pedido #1042</p>
              <p class="text-[0.7rem] text-ink/50">Tienda Nube · recién</p>
            </div>
            <span class="rounded-full bg-ok/15 px-2 py-0.5 text-[0.65rem] font-medium text-green-700">● Sincronizado</span>
          </div>
          <div class="mt-3 divide-y divide-ink/8 border-y border-ink/8 font-mono text-[0.7rem]">
            <div class="flex justify-between py-1.5"><span class="text-ink/55">Remera básica × 2</span><span>$38.000</span></div>
            <div class="flex justify-between py-1.5"><span class="text-ink/55">Buzo oversize × 1</span><span>$26.200</span></div>
            <div class="flex justify-between py-1.5 font-semibold"><span>Total</span><span>$64.200</span></div>
          </div>
          <ul class="mt-3 space-y-1.5 text-[0.72rem]">
            <li class="flex items-center gap-2"><Icon name="check-circle-fill" class="text-ok" /> Stock descontado del depósito</li>
            <li class="flex items-center gap-2"><Icon name="check-circle-fill" class="text-ok" /> Factura B emitida en ARCA</li>
            <li class="flex items-center gap-2"><Icon name="check-circle-fill" class="text-ok" /> Aviso por WhatsApp al cliente</li>
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-stagger>
      {
        apps.map(([src, name, text]) => (
          <article class="card flex items-start gap-4 p-5">
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-white">
              <img src={src} alt="" width="28" height="28" loading="lazy" decoding="async" class="h-7 w-7 object-contain" />
            </span>
            <div>
              <h3 class="font-medium">{name}</h3>
              <p class="mt-1 text-sm leading-relaxed text-fg/60">{text}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
