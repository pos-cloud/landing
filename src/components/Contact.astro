---
import Icon from './Icon.astro'
import SectionHead from './SectionHead.astro'
import { email, whatsappHref, type Plan } from '../data/site'

interface Props {
  plan?: Plan | null
  heading?: 'h1' | 'h2'
}

const { plan = null, heading = 'h2' } = Astro.props
---

<section id="contacto" class="relative overflow-hidden px-4 pt-32 pb-12 md:px-6 md:pt-40">
  <div class="bg-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div
    class="pointer-events-none absolute -top-40 left-1/2 h-[560px] w-[1000px] -translate-x-1/2 rounded-full bg-[radial-gradient(closest-side,color-mix(in_srgb,var(--color-blue)_32%,transparent),transparent)]"
    aria-hidden="true"
  >
  </div>
  <div class="relative mx-auto max-w-5xl">
    <SectionHead eyebrow="Contacto" heading={heading}>
      <Fragment slot="title">Hablemos de <span class="text-gradient">tu negocio</span></Fragment>
      Escribinos y coordinamos una demo de POS Cloud. Te respondemos personalmente.
    </SectionHead>

    <div class="mt-12 grid gap-4 md:grid-cols-[1.3fr_1fr]" data-stagger>
      <a
        class="card-brand group flex flex-col justify-between gap-10 p-7 transition-transform hover:-translate-y-1"
        href={whatsappHref(plan)}
        target="_blank"
        rel="noopener noreferrer"
        data-contact-link
      >
        <span class="grid h-12 w-12 place-items-center rounded-2xl bg-white text-2xl text-ink"><Icon name="whatsapp" /></span>
        <span>
          <span class="block text-sm text-fg/65">WhatsApp · respuesta rápida</span>
          <span class="mt-1 flex items-center justify-between gap-3 text-2xl font-medium tracking-tight">
            <span data-contact-label>{plan ? `Quiero el plan ${plan}` : 'Escribinos por WhatsApp'}</span>
            <Icon name="arrow-up-right" class="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
          </span>
        </span>
      </a>
      <a class="card group flex flex-col justify-between gap-10 p-7 transition-transform hover:-translate-y-1" href={`mailto:${email}`}>
        <span class="grid h-12 w-12 place-items-center rounded-2xl bg-blue/15 text-2xl text-sky"><Icon name="envelope" /></span>
        <span>
          <span class="block text-sm text-fg/55">Correo electrónico</span>
          <span class="mt-1 flex items-center justify-between gap-3 text-xl font-medium tracking-tight">
            {email}
            <Icon name="arrow-up-right" class="text-fg/50" />
          </span>
        </span>
      </a>
    </div>
  </div>
</section>

<script>
  import { whatsappHref } from '../data/site'

  const plans = ['Basic', 'Pro', 'Max']

  function applyPlan() {
    const plan = new URLSearchParams(window.location.search).get('plan')
    if (!plan || !plans.includes(plan)) return
    document.querySelectorAll<HTMLAnchorElement>('[data-contact-link]').forEach((link) => {
      link.href = whatsappHref(plan)
      const label = link.querySelector('[data-contact-label]')
      if (label) label.textContent = `Quiero el plan ${plan}`
    })
  }

  document.addEventListener('astro:page-load', applyPlan)
</script>
