---
import Icon from './Icon.astro'
import { whatsappHref } from '../data/site'
---

<section class="px-4 pb-24 md:px-6">
  <div class="card-brand relative mx-auto max-w-7xl overflow-hidden px-6 pt-20 text-center md:pt-24" data-reveal>
    <div class="bg-grid pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>
    <div
      class="pointer-events-none absolute top-[38%] left-1/2 h-[900px] w-[1400px] -translate-x-1/2 rounded-[50%] border-t border-sky/40 shadow-[0_-30px_80px_-20px_var(--color-blue)]"
      aria-hidden="true"
    >
    </div>
    <div class="relative">
      <div class="mx-auto grid h-16 w-16 place-items-center rounded-2xl border border-white/15 bg-white/10 text-2xl text-white shadow-[0_0_40px_-6px_var(--color-blue)]">
        <Icon name="cloud-check" />
      </div>
      <h2 class="mx-auto mt-8 max-w-3xl text-[clamp(2rem,4.6vw,3.6rem)] leading-[1.05] font-medium tracking-[-0.035em] text-balance">
        Tu negocio, ordenado en <span class="text-gradient">un solo sistema</span>
      </h2>
      <p class="mx-auto mt-5 max-w-xl text-lg text-fg/70">
        Escribinos por WhatsApp, contanos cómo trabajás y te mostramos POS Cloud funcionando.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a class="btn btn-light" href={whatsappHref()} target="_blank" rel="noopener noreferrer">
          <Icon name="whatsapp" /> Pedí una demo
        </a>
        <a class="btn btn-ghost" href="/precios">Ver precios <Icon name="arrow-up-right" /></a>
      </div>
    </div>
    <p
      class="relative mt-16 -mb-[0.22em] bg-gradient-to-b from-white/16 to-transparent bg-clip-text text-[clamp(3.4rem,16.5vw,15rem)] leading-none font-semibold tracking-[-0.06em] whitespace-nowrap text-transparent select-none"
      aria-hidden="true"
    >
      POS Cloud
    </p>
  </div>
</section>
