---
// Pantalla ilustrativa del sistema: datos de ejemplo, no son de un cliente real.
import Icon from './Icon.astro'

const menu = [
  ['house', 'Inicio', true],
  ['receipt', 'Ventas', false],
  ['bag', 'Compras', false],
  ['box-seam', 'Stock', false],
  ['cash-stack', 'Caja', false],
  ['journal-text', 'Contabilidad', false],
] as const

const kpis = [
  ['Ventas de hoy', '$1.284.920', '+12,4%', 'up'],
  ['Ticket promedio', '$18.350', '+3,1%', 'up'],
  ['Stock bajo', '12 productos', 'Reponer', 'warn'],
  ['Caja', 'Abierta', 'Turno mañana', 'ok'],
] as const

const rows = [
  ['Factura B 0003-00012845', 'Mostrador', '$28.600', 'ARCA ✓', 'ok'],
  ['Pedido #1042', 'Tienda Nube', '$64.200', 'Sincronizado', 'ok'],
  ['Pedido #2218', 'App vendedor', '$112.000', 'Cta. corriente', 'info'],
  ['Compra 0001-00004512', 'Proveedor', '−$86.500', 'Stock +240', 'warn'],
] as const

const tone = {
  ok: 'bg-ok/12 text-ok',
  info: 'bg-sky/12 text-sky',
  warn: 'bg-warn/12 text-warn',
  up: 'text-ok',
} as const
---

<div class="overflow-hidden rounded-2xl border border-white/10 bg-panel text-left shadow-[0_40px_120px_-30px_var(--color-blue)]" aria-hidden="true">
  <div class="flex items-center gap-2 border-b border-white/8 px-4 py-3">
    <span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
    <span class="ml-3 rounded-md bg-white/5 px-3 py-1 font-mono text-[0.68rem] text-fg/50">app.poscloud.com.ar</span>
  </div>
  <div class="grid md:grid-cols-[190px_1fr]">
    <aside class="hidden border-r border-white/8 p-3 md:block">
      <p class="px-2 pb-2 font-mono text-[0.62rem] tracking-widest text-fg/40 uppercase">Gestión</p>
      <ul class="space-y-0.5 text-[0.8rem]">
        {
          menu.map(([icon, label, on]) => (
            <li class:list={['flex items-center gap-2.5 rounded-lg px-2 py-1.5', on ? 'bg-white/8 text-fg' : 'text-fg/55']}>
              <Icon name={icon} class="text-[0.85rem]" />
              {label}
            </li>
          ))
        }
      </ul>
      <div class="mt-6 rounded-xl border border-white/8 bg-white/[0.03] p-3">
        <p class="flex items-center gap-1.5 text-[0.72rem] font-medium"><Icon name="stars" class="text-sky" /> Preguntale a Claude</p>
        <p class="mt-1.5 text-[0.68rem] leading-snug text-fg/50">“¿Qué producto vendí más esta semana?”</p>
      </div>
    </aside>

    <div class="p-4 md:p-5">
      <div class="flex items-end justify-between">
        <div>
          <p class="font-mono text-[0.62rem] tracking-widest text-fg/40 uppercase">Martes · Sucursal centro</p>
          <p class="mt-1 text-base font-medium">Buen día, así viene el negocio</p>
        </div>
        <span class="hidden rounded-full bg-blue px-3 py-1.5 text-[0.7rem] font-medium text-white sm:inline">+ Nueva venta</span>
      </div>

      <div class="mt-4 grid grid-cols-2 gap-2.5 lg:grid-cols-4">
        {
          kpis.map(([label, value, delta, kind]) => (
            <div class="rounded-xl border border-white/8 bg-white/[0.03] p-3">
              <p class="text-[0.68rem] text-fg/50">{label}</p>
              <p class="mt-1 text-[0.95rem] font-semibold tracking-tight">{value}</p>
              <p class:list={['mt-0.5 text-[0.64rem]', kind === 'warn' ? 'text-warn' : kind === 'ok' ? 'text-ok' : tone.up]}>{delta}</p>
            </div>
          ))
        }
      </div>

      <div class="mt-2.5 grid gap-2.5 lg:grid-cols-[1.4fr_1fr]">
        <div class="rounded-xl border border-white/8 bg-white/[0.03] p-3">
          <div class="flex items-center justify-between">
            <p class="text-[0.72rem] text-fg/60">Ventas · últimos 30 días</p>
            <p class="font-mono text-[0.62rem] text-fg/40">ARS</p>
          </div>
          <svg viewBox="0 0 300 90" class="mt-2 h-24 w-full" preserveAspectRatio="none">
            <defs>
              <linearGradient id="mock-area" x1="0" x2="0" y1="0" y2="1">
                <stop offset="0" stop-color="var(--color-sky)" stop-opacity="0.35"></stop>
                <stop offset="1" stop-color="var(--color-sky)" stop-opacity="0"></stop>
              </linearGradient>
            </defs>
            <path d="M0 70 C25 62 40 66 60 55 S95 40 120 46 165 30 190 34 230 18 255 22 285 10 300 8 V90 H0 Z" fill="url(#mock-area)"></path>
            <path data-mock-line d="M0 70 C25 62 40 66 60 55 S95 40 120 46 165 30 190 34 230 18 255 22 285 10 300 8" fill="none" stroke="var(--color-sky)" stroke-width="2" vector-effect="non-scaling-stroke"></path>
          </svg>
        </div>
        <div class="rounded-xl border border-white/8 bg-white/[0.03] p-3">
          <p class="text-[0.72rem] text-fg/60">Canales de venta</p>
          <ul class="mt-2.5 space-y-2 text-[0.7rem]">
            {
              [
                ['Mostrador', 46],
                ['Tienda Nube', 24],
                ['Mercado Libre', 18],
                ['Vendedores', 12],
              ].map(([name, pct]) => (
                <li>
                  <div class="flex justify-between text-fg/70">
                    <span>{name}</span>
                    <span class="font-mono">{pct}%</span>
                  </div>
                  <div class="mt-1 h-1.5 rounded-full bg-white/8">
                    <div class="h-full rounded-full bg-gradient-to-r from-blue to-sky" style={`width:${pct * 2}%`} />
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="mt-2.5 overflow-hidden rounded-xl border border-white/8">
        <div class="grid grid-cols-[1.6fr_1fr_0.9fr] gap-2 border-b border-white/8 bg-white/[0.03] px-3 py-2 font-mono text-[0.6rem] tracking-wider text-fg/40 uppercase sm:grid-cols-[1.6fr_1fr_0.9fr_1fr]">
          <span>Comprobante</span><span>Canal</span><span class="text-right">Importe</span><span class="hidden text-right sm:block">Estado</span>
        </div>
        {
          rows.map(([doc, channel, amount, state, kind]) => (
            <div class="grid grid-cols-[1.6fr_1fr_0.9fr] items-center gap-2 border-b border-white/5 px-3 py-2 text-[0.72rem] last:border-0 sm:grid-cols-[1.6fr_1fr_0.9fr_1fr]">
              <span class="truncate">{doc}</span>
              <span class="truncate text-fg/55">{channel}</span>
              <span class:list={['text-right font-mono', amount.startsWith('−') ? 'text-fg/60' : '']}>{amount}</span>
              <span class="hidden justify-end sm:flex">
                <span class:list={['rounded-full px-2 py-0.5 text-[0.62rem]', tone[kind]]}>{state}</span>
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</div>
