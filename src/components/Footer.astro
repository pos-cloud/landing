---
import Icon from './Icon.astro'
import { nav, email, whatsappHref } from '../data/site'
---

<footer class="border-t border-white/8">
  <div class="mx-auto max-w-7xl px-4 py-14 md:px-6">
    <div class="flex flex-col gap-10 md:flex-row md:justify-between">
      <div class="max-w-xs">
        <a href="/" aria-label="POS Cloud, ir al inicio">
          <img src="/assets/img/logo-pos-cloud.png" alt="" width="222" height="112" loading="lazy" decoding="async" class="h-9 w-auto" />
        </a>
        <p class="mt-4 text-sm leading-relaxed text-fg/60">
          Sistema de gestión y punto de venta en la nube para empresas y comercios de cualquier rubro.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-10 sm:grid-cols-3">
        <div>
          <p class="text-sm font-semibold">Producto</p>
          <ul class="mt-4 space-y-2.5 text-sm text-fg/60">
            {
              nav.slice(0, 4).map((item) => (
                <li>
                  <a class="hover:text-fg" href={item.href}>{item.label}</a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <p class="text-sm font-semibold">Empresa</p>
          <ul class="mt-4 space-y-2.5 text-sm text-fg/60">
            <li><a class="hover:text-fg" href="/contacto">Contacto</a></li>
            <li><a class="hover:text-fg" href="/politica_privacidad">Política de privacidad</a></li>
          </ul>
        </div>
        <div>
          <p class="text-sm font-semibold">Hablemos</p>
          <ul class="mt-4 space-y-2.5 text-sm text-fg/60">
            <li>
              <a class="inline-flex items-center gap-2 hover:text-fg" href={whatsappHref()} target="_blank" rel="noopener noreferrer">
                <Icon name="whatsapp" /> WhatsApp
              </a>
            </li>
            <li>
              <a class="inline-flex items-center gap-2 hover:text-fg" href={`mailto:${email}`}>
                <Icon name="envelope" /> {email}
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-14 flex flex-col gap-2 border-t border-white/8 pt-6 text-xs text-fg/45 sm:flex-row sm:justify-between">
      <p>© 2015–{new Date().getFullYear()} POS Cloud. Todos los derechos reservados.</p>
      <p>Hecho en Argentina.</p>
    </div>
  </div>
</footer>
