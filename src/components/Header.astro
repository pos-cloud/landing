---
import Icon from './Icon.astro'
import { nav, whatsappHref } from '../data/site'

interface Props {
  current: string
}

const { current } = Astro.props
---

<header class="site-header fixed inset-x-0 top-0 z-50 border-b border-transparent transition-colors duration-300" data-header>
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-4 md:h-[4.5rem] md:px-6">
    <a href="/" class="shrink-0" aria-label="POS Cloud, ir al inicio">
      <img src="/assets/img/logo-pos-cloud.png" alt="" width="222" height="112" fetchpriority="high" class="h-9 w-auto md:h-10" />
    </a>

    <nav class="hidden lg:block" aria-label="Principal">
      <ul class="flex items-center gap-1">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  'rounded-full px-3.5 py-2 text-sm transition-colors',
                  current === item.href ? 'text-fg' : 'text-fg/65 hover:text-fg',
                ]}
                aria-current={current === item.href ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a class="btn btn-primary hidden sm:inline-flex" href={whatsappHref()} target="_blank" rel="noopener noreferrer">
        Pedí una demo
      </a>
      <details class="relative lg:hidden" data-menu>
        <summary class="grid h-10 w-10 cursor-pointer list-none place-items-center rounded-full border border-white/15 text-lg" aria-label="Abrir menú">
          <Icon name="list" />
        </summary>
        <div class="card absolute top-12 right-0 w-64 p-2 shadow-2xl shadow-black/60">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} class="block rounded-xl px-3 py-2.5 text-fg/85 hover:bg-white/5 hover:text-fg">
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <a class="btn btn-primary mt-2 w-full justify-center" href={whatsappHref()} target="_blank" rel="noopener noreferrer">
            Pedí una demo
          </a>
        </div>
      </details>
    </div>
  </div>
</header>
