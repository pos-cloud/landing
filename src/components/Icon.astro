---
// Inline SVG from bootstrap-icons, resolved at build time.
// Only the icons that are actually rendered end up in the HTML.
const svgs = import.meta.glob<string>('/node_modules/bootstrap-icons/icons/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
})

interface Props {
  name: string
  class?: string
}

const { name, class: className } = Astro.props
const key = name.replace(/^bi-/, '')
const raw = svgs[`/node_modules/bootstrap-icons/icons/${key}.svg`]
if (!raw) throw new Error(`Icono bootstrap-icons inexistente: ${name}`)

const inner = raw.replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '')
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 16 16"
  width="1em"
  height="1em"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
  class:list={['bi-svg', className]}
  set:html={inner}
/>
