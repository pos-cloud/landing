---
import Icon from './Icon.astro'
import { practices } from '../data/site'

interface Props {
  heading?: 'h1' | 'h2'
}

const { heading = 'h2' } = Astro.props
const Title = heading
---

<section id="nucleo" class="flex min-h-dvh items-center px-5 py-28 md:px-16 md:pr-28">
  <div class="grid w-full items-center gap-10 lg:grid-cols-[1.05fr_0.95fr]">
    <div data-reveal>
      <p class="mb-4 text-xs font-extrabold tracking-[0.18em] text-acid uppercase">El núcleo</p>
      <Title class="max-w-[14ch] font-display text-[clamp(2.2rem,5vw,4.6rem)] leading-[0.98] font-extrabold tracking-tight">
        El manejo de la información, en un solo lugar.
      </Title>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-white/80">
        Tené el control de todas las operaciones de tu empresa en un solo lugar. El núcleo es la base que toda empresa necesita, y sobre él construimos un sistema a tu medida, con lo último en tecnología e inteligencia artificial.
      </p>
      <div class="mt-6 flex items-center gap-3 rounded-2xl border border-white/15 bg-white/10 p-4">
        <img src="/assets/img/logo-claude.svg" alt="" width="40" height="40" loading="lazy" decoding="async" class="h-10 w-10 shrink-0" />
        <p>Claude lee ventas, productos, stock y caja, y te responde con lo que ya pasó en el negocio.</p>
      </div>
    </div>
    <div class="grid gap-3 sm:grid-cols-2" data-stagger aria-label="Prácticas del núcleo">
      {
        practices.map(([icon, title, text]) => (
          <article class="practice rounded-3xl bg-white p-4 text-ink">
            <h3 class="flex items-center gap-2.5 font-display text-xl font-bold">
              <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-blue/10 text-lg text-blue">
                <Icon name={icon} />
              </span>
              {title}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-ink/70">{text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
