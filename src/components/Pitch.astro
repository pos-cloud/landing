---
import SectionHead from './SectionHead.astro'
import Faq from './Faq.astro'
import type { Pitch } from '../data/pitch'

type Props = Pitch

const { eyebrow, title, intro, points = [], faqs = [] } = Astro.props
---

{
  points.length > 0 && (
    <section class="px-4 py-24 md:px-6 md:py-28">
      <div class="mx-auto max-w-7xl">
        <SectionHead eyebrow={eyebrow}>
          <Fragment slot="title">{title}</Fragment>
          {intro}
        </SectionHead>
        <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-stagger>
          {points.map(([pointTitle, text]) => (
            <article class="card p-6">
              <h3 class="text-lg font-medium">{pointTitle}</h3>
              <p class="mt-2 leading-relaxed text-fg/60">{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}

{faqs.length > 0 && <Faq faqs={faqs} />}
