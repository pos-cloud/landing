---
import Icon from './Icon.astro'
import { whatsappHref } from '../data/site'
import type { Pitch } from '../data/pitch'

type Props = Pitch

const { eyebrow, title, intro, points = [], faqs = [], cta } = Astro.props

const faqJsonLd = faqs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map(([question, answer]) => ({
        '@type': 'Question',
        name: question,
        acceptedAnswer: { '@type': 'Answer', text: answer },
      })),
    }
  : null
---

<section class="px-5 pb-28 md:px-16 md:pr-28">
  <div data-reveal>
    <p class="mb-4 text-xs font-extrabold tracking-[0.18em] text-acid uppercase">{eyebrow}</p>
    <h2 class="max-w-[18ch] font-display text-[clamp(2rem,4.4vw,3.8rem)] leading-[0.98] font-extrabold tracking-tight">
      {title}
    </h2>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-white/80">{intro}</p>
  </div>

  {
    points.length > 0 && (
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-stagger>
        {points.map(([pointTitle, text]) => (
          <article class="rounded-3xl border border-white/15 bg-white/6 p-5">
            <h3 class="font-display text-xl font-extrabold">{pointTitle}</h3>
            <p class="mt-2 leading-relaxed text-white/75">{text}</p>
          </article>
        ))}
      </div>
    )
  }

  {
    faqs.length > 0 && (
      <div class="mt-16 max-w-3xl" data-reveal>
        <h2 class="font-display text-3xl font-extrabold tracking-tight">Preguntas frecuentes</h2>
        <div class="mt-6 divide-y divide-white/10 border-y border-white/10" data-stagger>
          {faqs.map(([question, answer]) => (
            <details class="group py-4" data-faq>
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-bold">
                <h3 class="text-lg">{question}</h3>
                <span class="text-acid" data-faq-icon aria-hidden="true">+</span>
              </summary>
              <div class="overflow-hidden" data-faq-body><p class="pt-3 leading-relaxed text-white/75">{answer}</p></div>
            </details>
          ))}
        </div>
      </div>
    )
  }

  <a
    data-reveal
    class="mt-12 inline-flex items-center gap-3 rounded-full bg-acid py-2 pr-5 pl-2 font-extrabold text-ink"
    href={whatsappHref()}
    target="_blank"
    rel="noopener noreferrer"
  >
    <span class="grid h-11 w-11 place-items-center rounded-full bg-ink text-xl text-acid"><Icon name="whatsapp" /></span>
    <span>{cta}</span>
  </a>

  {faqJsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}
</section>
