---
interface Props {
  title: string
  description: string
  path: string
  noindex?: boolean
}

const { title, description, path, noindex = false } = Astro.props
const canonical = new URL(path, Astro.site).toString()
const image = new URL('/og.png', Astro.site).toString()
const imageAlt = 'POS Cloud, sistema de gestión en la nube para comercios'
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
{!noindex && <link rel="canonical" href={canonical} />}
<meta property="og:site_name" content="POS Cloud" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:type" content="website" />
<meta property="og:locale" content="es_AR" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={imageAlt} />
