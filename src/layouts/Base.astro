---
import '../styles/global.css'
import { ClientRouter } from 'astro:transitions'
import Seo from '../components/Seo.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import CtaFinal from '../components/CtaFinal.astro'

interface Props {
  title: string
  description: string
  path: string
  cta?: boolean
  jsonLd?: Record<string, unknown>
  noindex?: boolean
}

const { title, description, path, cta = true, jsonLd, noindex = false } = Astro.props

const siteJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://poscloud.com.ar/#organization',
      name: 'POS Cloud',
      url: 'https://poscloud.com.ar/',
      logo: 'https://poscloud.com.ar/assets/img/logo-pos-cloud.png',
      email: 'info@poscloud.com.ar',
      foundingDate: '2015',
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'sales',
        telephone: '+54-9-3564-368535',
        email: 'info@poscloud.com.ar',
        areaServed: 'AR',
        availableLanguage: 'es',
      },
    },
    {
      '@type': 'WebSite',
      '@id': 'https://poscloud.com.ar/#website',
      name: 'POS Cloud',
      url: 'https://poscloud.com.ar/',
      inLanguage: 'es-AR',
      publisher: { '@id': 'https://poscloud.com.ar/#organization' },
    },
  ],
}
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#06080d" />
    <meta name="google-site-verification" content="NCHntMRzHdXwNGzsjgL1HqbKOjrCieZ1S3S00TPgNeI" />
    <Seo title={title} description={description} path={path} noindex={noindex} />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} />}
    {
      jsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      )
    }
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-WSG747BSDT"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || []
      function gtag() {
        dataLayer.push(arguments)
      }
      gtag('js', new Date())
      gtag('config', 'G-WSG747BSDT')
    </script>
  </head>
  <body class="overflow-x-hidden bg-ink font-sans text-fg">
    <Header current={path} />
    <slot />
    {cta && <CtaFinal />}
    <Footer />
    <script>
      import '../scripts/animations.ts'
    </script>
  </body>
</html>
