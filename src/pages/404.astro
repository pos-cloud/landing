---
import Base from '../layouts/Base.astro'
---

<Base path="/404" title="Página no encontrada — POS Cloud" description="Esa página no está en POS Cloud." noindex={true}>
  <main class="relative flex min-h-[80dvh] flex-col items-center justify-center overflow-hidden px-4 pt-24 text-center">
    <div class="bg-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <p class="eyebrow relative">Error 404</p>
    <h1 class="relative mt-4 text-[clamp(2.4rem,6vw,4.4rem)] leading-tight font-medium tracking-[-0.04em]">Esa página no está</h1>
    <p class="relative mt-4 text-fg/60">Puede que la dirección haya cambiado. Volvé al inicio y seguí desde ahí.</p>
    <a class="btn btn-primary relative mt-8" href="/">Volver al inicio</a>
  </main>
</Base>
