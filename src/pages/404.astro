---
import Base from '../layouts/Base.astro'
---

<Base
  path="/404"
  title="Página no encontrada — POS Cloud"
  description="Esa página no está en POS Cloud."
  progress={0}
  noindex={true}
>
  <main class="flex min-h-dvh flex-col justify-center px-5 md:px-16">
    <p class="text-xs font-extrabold tracking-[0.18em] text-acid uppercase">404</p>
    <h1 class="mt-3 font-display text-5xl font-extrabold tracking-tight">Esa página no está.</h1>
    <a class="mt-6 inline-flex w-fit rounded-full bg-acid px-4 py-3 font-extrabold text-ink" href="/">Volver al inicio</a>
  </main>
</Base>
