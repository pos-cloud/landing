---
import Nucleo from '../components/Nucleo.astro'
import Pitch from '../components/Pitch.astro'
import { nucleoPitch } from '../data/pitch'
import Day from '../components/Day.astro'
import Base from '../layouts/Base.astro'

const description =
  'Ventas, compras, control de stock, caja, contabilidad y producción en un solo sistema. El núcleo de POS Cloud junta toda la operación de tu negocio.'
---

<Base
  path="/nucleo"
  title="Ventas, stock y caja en un solo sistema — POS Cloud"
  description={description}
>
  <main class="pt-16">
    <Nucleo heading="h1" />
    <Day />
    <Pitch {...nucleoPitch} />
  </main>
</Base>
